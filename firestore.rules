rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /leaderboard/{playerId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.auth.uid == playerId
        && request.resource.data.keys().hasOnly([
          'displayName', 'avatar', 'totalPoints', 'quizzesPlayed',
          'bestScore', 'lastScore', 'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.avatar is string
        && request.resource.data.lastScore is int
        && request.resource.data.lastScore >= 0
        && request.resource.data.lastScore <= 8
        && request.resource.data.totalPoints == request.resource.data.lastScore * 20
        && request.resource.data.quizzesPlayed == 1
        && request.resource.data.bestScore == request.resource.data.lastScore;

      allow update: if request.auth != null
        && request.auth.uid == playerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'avatar', 'totalPoints', 'quizzesPlayed',
          'bestScore', 'lastScore', 'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.avatar is string
        && request.resource.data.lastScore is int
        && request.resource.data.lastScore >= 0
        && request.resource.data.lastScore <= 8
        && request.resource.data.totalPoints == resource.data.totalPoints + request.resource.data.lastScore * 20
        && request.resource.data.quizzesPlayed == resource.data.quizzesPlayed + 1
        && request.resource.data.bestScore == (request.resource.data.lastScore > resource.data.bestScore
          ? request.resource.data.lastScore
          : resource.data.bestScore);

      allow delete: if false;
    }
  }
}
