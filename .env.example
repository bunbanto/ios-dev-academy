# SwiftLab iOS Academy — Firebase Authentication (Google та Email/Password)

# Скопіюйте цей файл у .env.local та вставте ваші значення з Firebase Console:
# Firebase Console -> Project Settings -> General -> Your apps -> Web app (конфігурація SDK)

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyYourActualApiKeyHere
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# ==============================================================================
# Безкоштовна AI-перевірка практичних завдань через Google Gemini Developer API
# ==============================================================================
# ВАЖЛИВО: Змінна GEMINI_API_KEY НЕ має префікса NEXT_PUBLIC_ — вона працює
# лише на сервері (Next.js API Routes) і ніколи не передається у браузер.
# Створіть безкоштовний ключ у https://aistudio.google.com/ (без прив'язки білінгу).
GEMINI_API_KEY=your-gemini-api-key-here

# Опціонально: основна та резервна безкоштовні моделі Gemini Flash
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Опціонально: денні ліміти AI-перевірок на користувача та секрет підпису AI-задач
# AI_DAILY_LIMIT_STUDENT=15
# AI_DAILY_LIMIT_ADMIN=100
# CHALLENGE_SIGNING_SECRET=replace-with-random-64-char-secret
