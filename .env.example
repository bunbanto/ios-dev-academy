# SwiftLab iOS Academy — Налаштування Firebase Authentication

# Скопіюйте цей файл у .env.local та вставте ваші значення з Firebase Console:
# Firebase Console -> Project Settings -> General -> Your apps -> Web app (конфігурація SDK)

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyYourActualApiKeyHere
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
